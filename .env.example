# Copy to .env and adjust. docker compose reads it automatically.

# Password for the admin (host) login. Required.
ADMIN_PASSWORD=change-me

# Optional: secret for signing admin tokens. Defaults to one derived from ADMIN_PASSWORD.
JWT_SECRET=

# Database credentials (only used inside Docker).
POSTGRES_USER=kiko
POSTGRES_PASSWORD=kiko
POSTGRES_DB=kiko

# Port the app is reachable on: http://localhost:8080
APP_PORT=8080
